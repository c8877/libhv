# 从 relay/admin/web/dist 生成内嵌资源表（配置期运行，供 rtunnel-relay-embedded 使用）。
#
# 产物包含：每个文件的字节数组（优先用构建期预压缩的 .gz，缺失时嵌原文）、
# 以及一张 { 相对路径, 数据, 长度, 是否 gzip, Content-Type } 表。
# 用法:
#   cmake -DADMIN_DIST=<web/dist> -DOUT=<generated/admin_web_assets_data.hpp> -P gen_admin_web.cmake

if(NOT DEFINED ADMIN_DIST OR NOT DEFINED OUT)
    message(FATAL_ERROR "gen_admin_web.cmake: 需要 -DADMIN_DIST=<dir> -DOUT=<header>")
endif()

file(GLOB_RECURSE files RELATIVE "${ADMIN_DIST}" "${ADMIN_DIST}/*")
list(SORT files)

function(asset_ctype name out)
    get_filename_component(ext "${name}" EXT)
    string(TOLOWER "${ext}" ext)
    if(ext STREQUAL ".html" OR ext STREQUAL ".htm")
        set(ct "text/html; charset=utf-8")
    elseif(ext STREQUAL ".js" OR ext STREQUAL ".mjs")
        set(ct "application/javascript; charset=utf-8")
    elseif(ext STREQUAL ".css")
        set(ct "text/css; charset=utf-8")
    elseif(ext STREQUAL ".json" OR ext STREQUAL ".map")
        set(ct "application/json")
    elseif(ext STREQUAL ".svg")
        set(ct "image/svg+xml")
    elseif(ext STREQUAL ".png")
        set(ct "image/png")
    elseif(ext STREQUAL ".ico")
        set(ct "image/x-icon")
    elseif(ext STREQUAL ".woff2")
        set(ct "font/woff2")
    elseif(ext STREQUAL ".woff")
        set(ct "font/woff")
    elseif(ext STREQUAL ".ttf")
        set(ct "font/ttf")
    elseif(ext STREQUAL ".txt")
        set(ct "text/plain; charset=utf-8")
    else()
        set(ct "application/octet-stream")
    endif()
    set(${out} "${ct}" PARENT_SCOPE)
endfunction()

set(body "// 由 rtunnel/cmake/gen_admin_web.cmake 从 web/dist 生成，勿手改。\n")
set(rows "")
set(idx 0)
foreach(f ${files})
    if(f MATCHES "\\.(br|gz)$")
        continue()
    endif()
    set(src "${ADMIN_DIST}/${f}")
    set(is_gzip false)
    if(EXISTS "${src}.gz")
        set(src "${src}.gz")
        set(is_gzip true)
    endif()
    file(READ "${src}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    file(SIZE "${src}" sz)
    asset_ctype("${f}" ct)
    string(APPEND body "static const unsigned char kAW${idx}[] = {${hex}};\n")
    string(APPEND rows "    {\"${f}\", kAW${idx}, ${sz}, ${is_gzip}, \"${ct}\"},\n")
    math(EXPR idx "${idx}+1")
endforeach()

if(idx EQUAL 0)
    # 空目录也要生成合法代码；条目数为 0，查找永远失败
    string(APPEND body "static const unsigned char kAWEmpty[1] = {0};\n")
    string(APPEND rows "    {\"\", kAWEmpty, 0, false, \"application/octet-stream\"},\n")
endif()

string(APPEND body "static const AdminWebEntry kAdminWebEntries[] = {\n${rows}};\n")
string(APPEND body "static const unsigned int kAdminWebEntryCount = ${idx};\n")
file(WRITE "${OUT}" "${body}")
message(STATUS "rtunnel-admin-web: 内嵌 ${idx} 个文件 -> ${OUT}")
