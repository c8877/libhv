{
  "name": "rtunnel-admin-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run check:ui && npm run build:editor && vite",
    "build": "npm run check:ui && npm run build:editor && vite build && node scripts/precompress.mjs dist",
    "build:editor": "vite build --config vite.editor.config.js",
    "preview": "vite preview",
    "precompress": "node scripts/precompress.mjs dist",
    "check:docs": "node scripts/check-api-docs.mjs",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "build:local": "npm run check:ui && vite build --config vite.local.config.js && node scripts/inline-local-page.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.6.1",
    "element-plus": "^2.14.8",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8"
  }
}
