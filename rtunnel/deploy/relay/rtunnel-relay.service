[Unit]
Description=rtunnel relay (B)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=rtunnel
Group=rtunnel
WorkingDirectory=@PREFIX@
# 运行参数集中在 /etc/rtunnel/relay.env（安装时只写示例，不覆盖现网）：
#   RELAY_ARGS=--admin-token <token> --admin-ca-cert ...
# 管理台 HTTPS（二选一）：
#   RELAY_ARGS=... --admin-tls-selfsigned --admin-tls-days 3650
#   RELAY_ARGS=... --admin-tls-cert /etc/rtunnel/relay/admin.crt \
#                  --admin-tls-key /etc/rtunnel/relay/admin.key
EnvironmentFile=-/etc/rtunnel/relay.env
ExecStart=@PREFIX@/bin/rtunnel-relay \
    --host 0.0.0.0 --port 18443 \
    --admin 127.0.0.1:9443 \
    --admin-db @STATE_DIR@/admin.db \
    --admin-file-dir @STATE_DIR@/files \
    @FRONTEND_ARGS@ ${RELAY_ARGS}
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
StateDirectory=rtunnel/relay
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
