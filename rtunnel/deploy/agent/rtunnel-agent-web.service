[Unit]
Description=rtunnel agent (C, local device web)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/opt/rtunnel/agent
# 必填参数，例如：
#   AGENT_ARGS=--devid board01 --server 10.0.0.10 --port 18443 \
#              --allow 22,8080 --allow-shell
# 本地设备详情页（只读，GET / 和 /api/v1/sysinfo）：
#   默认只监听 127.0.0.1:8080；需要局域网访问时在 /etc/rtunnel/agent.env 写
#   AGENT_WEB=0.0.0.0:8080（页面会暴露设备型号、IP、串口等只读信息）
Environment=AGENT_WEB=127.0.0.1:8080
EnvironmentFile=-/etc/rtunnel/agent.env
# 文件管理（本地页面卡片 + relay-admin 共用同一个 WebSocket 通道）：
#   只读：AGENT_FILE_FLAGS=--file-ro
#   读写：AGENT_FILE_FLAGS=--file-rw
#   本地访问再加 token：AGENT_FILE_TOKEN_ARG=--file-token <token>
Environment=AGENT_FILE_ROOT=/opt/data/files
Environment=AGENT_FILE_MAX_MB=512
Environment=AGENT_FILE_FLAGS=--file-rw
Environment=AGENT_FILE_TOKEN_ARG=
ExecStartPre=/bin/mkdir -p ${AGENT_FILE_ROOT}
ExecStart=/opt/rtunnel/agent/bin/rtunnel-agent ${AGENT_ARGS} --local-web ${AGENT_WEB} \
          --file-root ${AGENT_FILE_ROOT} --file-max-mb ${AGENT_FILE_MAX_MB} \
          ${AGENT_FILE_FLAGS} ${AGENT_FILE_TOKEN_ARG}
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
