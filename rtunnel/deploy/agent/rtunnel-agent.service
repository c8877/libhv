[Unit]
Description=rtunnel agent
# lite/web 共用同一个 unit：变体只由 bin/rtunnel-agent 软链指向哪个版本决定。
# 设备离线时 agent 会自己重连，不需要等 network-online（部分板子的
# systemd-networkd-wait-online 会一直卡住，导致服务永远起不来）。
After=network.target
# OTA 重启会占用一次启动额度，给 boot-check 留出回滚次数
StartLimitBurst=10
StartLimitIntervalSec=120

[Service]
Type=simple
WorkingDirectory=/opt/rtunnel/agent
# 每台设备不同的身份与 relay 地址放在 /opt/data/etc/rtunnel-agent.args：
#   AGENT_ARGS=--devid board01 --server 10.0.0.10:18443 --allow 22,8080
# 能力开关在 /opt/data/etc/rtunnel-agent.json，不再写进 unit。
EnvironmentFile=-/opt/data/etc/rtunnel-agent.args
Environment=AGENT_ARGS=
# OTA 启动计数：连续多次起不来时自动切回上一个版本
ExecStartPre=-/opt/rtunnel/agent/bin/agent-boot-check.sh
# 用 sh 包一层：AGENT_ARGS 为空时不会产生空参数，带空格的值也按 shell 规则拆分
ExecStart=/bin/sh -c 'exec /opt/rtunnel/agent/bin/rtunnel-agent $AGENT_ARGS --config-file /opt/data/etc/rtunnel-agent.json'
# 正常退出（OTA 安装完成）也要拉起，因此用 always
Restart=always
RestartSec=3
LimitNOFILE=65535
LogsDirectory=rtunnel

[Install]
WantedBy=multi-user.target
